# Copier ce fichier en .env et remplir les valeurs.

# Port HTTP du serveur
PORT=3000

# 'production' active les contrôles stricts (secret obligatoire, pas de code SMS renvoyé)
NODE_ENV=development

# Secret de signature des sessions : une longue chaîne aléatoire en production
JWT_SECRET=

# Base de données. Vide : fichier SQLite local (développement uniquement).
# Production : postgres://utilisateur:motdepasse@hote:5432/lango
DATABASE_URL=
SQLITE_PATH=lango-dev.sqlite

# En développement, le code SMS est renvoyé à l'application pour tester sans SMS.
DEV_OTP=true

# Moteur de traduction : mock (factice, gratuit), google ou claude
TRANSLATION_PROVIDER=mock
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Demandes de contact maximum par personne et par jour (anti-spam)
DAILY_CONTACT_REQUEST_LIMIT=20
