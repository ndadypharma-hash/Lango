{
  "name": "lango-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur Lango : comptes, découverte, demandes de contact et messagerie traduite en temps réel",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.8",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
